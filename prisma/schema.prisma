datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AssetCategory {
  LUXURY_FLAT
  LANDED_VILLA
  COMMERCIAL_OFFICE
}

enum CorridorZone {
  PATIA_INFOCITY
  PAHALA_NH16
  SAHEED_NAGAR_CORE
  KALINGA_NAGAR_AIIMS
  TRISULIA_METRO_BELT
  SUNDARPADA_JATNI
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Chief Investment Officer")
  role         String   @default("SUPER_ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Property {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  title                 String
  subtitle              String?
  category              AssetCategory
  corridor              CorridorZone
  corridorDisplayName   String?
  microLocation         String
  
  basePriceInr          BigInt
  priceDisplay          String?
  pricePerSqFt          Int
  reraCarpetSqFt        Int
  superBuiltUpSqFt      Int
  loadingPercentage     Float
  udsLandSqFt           Int?
  estimatedRentalYield  Float?
  configuration         String?
  possessionTimeline    String?

  oreraNumber           String        @unique
  oreraVerifiedUrl      String?
  bdaSanctionNumber     String?
  bhulekhKhataPlot      String?
  kissamStatus          String        @default("Gharabari Verified")
  ecYearsVerified       Int           @default(30)
  approvedBanks         String[]
  
  assetScoreTotal       Int
  scoreLegalPurity      Int           @default(20)
  scoreMaterialGrade    Int           @default(20)
  scoreCorridorGrowth   Int           @default(20)
  scoreCarpetEfficiency Int           @default(20)
  scoreVastuLight       Int           @default(20)

  curatorStrengths      String[]
  curatorTradeOffNote   String        @default("")
  idealBuyerPersona     String        @default("")

  dayHeroImageUrl       String
  duskHeroImageUrl      String
  rawSiteVideoUrl       String?
  instagramReelUrl      String?
  isOffMarketVault      Boolean       @default(false)
  isGoldPick            Boolean       @default(false)
  
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  leads                 AdvisoryLead[]
}

model AdvisoryLead {
  id                      String        @id @default(cuid())
  fullName                String
  whatsappNumber          String
  whatsappNumberMasked    String?
  encryptedNotes          String?
  buyerPersona            String
  coDecisionMakers        String[]
  preferredTourSlot       String?
  interestedPropertyId    String?
  interestedPropertyTitle String?
  property                Property?     @relation(fields: [interestedPropertyId], references: [id])
  utmSource               String?
  status                  String        @default("NEW_VIP")
  leadType                String        @default("GOLDEN_HOUR")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @default(now()) @updatedAt
}


model BlogPost {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  subtitle            String?
  metaTitle           String
  metaDescription     String
  excerpt             String
  category            String
  publishedAt         DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  readingTime         String   @default("8 min read")
  authorName          String   @default("Asset Properties Research Desk")
  authorRole          String   @default("Senior Due Diligence Team")
  authorAvatar        String   @default("/avatars/advisor.jpg")
  authorBio           String   @default("Institutional real estate underwriting desk in Bhubaneswar.")
  reviewedByName      String?
  reviewedByRole      String?
  featuredImage       String
  featuredImageAlt    String
  corridor            String?
  keyTakeaways        String[]
  sectionsJson        Json     @default("[]")
  faqJson             Json     @default("[]")
  keywords            String[]
  relatedProperties   String[]
  isPublished         Boolean  @default(true)
  viewCount           Int      @default(0)
  createdAt           DateTime @default(now())
}
